# Resend API key used by /api/inquiry to email service requests (server-only; never prefix with NEXT_PUBLIC_).
RESEND_API_KEY=
# Inbox that receives website service requests.
INQUIRY_TO_EMAIL=
# Optional sender, e.g. "Plumbers on Call Website <requests@your-verified-domain.com>"; defaults to Resend's onboarding@resend.dev.
INQUIRY_FROM_EMAIL=
